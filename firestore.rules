rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() { return userDoc().role; }

    function isAdmin()   { return isAuth() && userRole() == 'admin'; }
    function isManager() { return isAuth() && (userRole() == 'admin' || userRole() == 'manager'); }

    function inGroup(gid) {
      return isAuth() && gid in userDoc().get('groups', []);
    }

    // ── Users ──
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && (
        request.auth.uid == uid ||
        isAdmin()
      );
    }

    // ── Groups ──
    match /groups/{gid} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Tasks
      match /tasks/{tid} {
        allow read:   if inGroup(gid);
        allow create: if isManager() && inGroup(gid);
        allow update: if inGroup(gid);
        allow delete: if isManager() && inGroup(gid);

        match /comments/{cid} {
          allow read:   if inGroup(gid);
          allow create: if inGroup(gid);
          allow update, delete: if isAdmin();
        }
        match /history/{hid} {
          allow read:   if inGroup(gid);
          allow create: if inGroup(gid);
          allow update, delete: if isAdmin();
        }
      }

      // Activity
      match /activity/{aid} {
        allow read:   if inGroup(gid) || isAdmin();
        allow create: if isAuth();
        allow update, delete: if isAdmin();
      }
    }
  }
}
