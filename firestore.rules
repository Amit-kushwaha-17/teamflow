rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isAuth() && getUserData().status == 'approved';
    }

    function getRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isApproved() && getRole() == 'admin';
    }

    function isManager() {
      return isApproved() && (getRole() == 'admin' || getRole() == 'manager');
    }

    // ── Users ──
    match /users/{userId} {
      // Any authenticated user can read users
      // (needed to check if team is empty during first-admin registration)
      allow read: if isAuth();

      // Users can create their own profile doc (during registration)
      allow create: if isAuth() && request.auth.uid == userId;

      // Admins can update anyone; users can update their own non-role fields
      allow update: if isAdmin() ||
        (isAuth() && request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']));

      allow delete: if isAdmin();
    }

    // ── Tasks ──
    match /tasks/{taskId} {
      allow read: if isApproved();
      allow create: if isManager();
      allow update: if isApproved();
      allow delete: if isManager();

      match /comments/{commentId} {
        allow read: if isApproved();
        allow create: if isApproved();
        allow update, delete: if isAdmin();
      }

      match /history/{historyId} {
        allow read: if isApproved();
        allow create: if isApproved();
        allow update, delete: if isAdmin();
      }
    }

    // ── Activity Log ──
    match /activity/{activityId} {
      allow read: if isApproved();
      // Allow any authenticated user to write activity
      // (needed during registration before doc is approved)
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ── Notifications ──
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.recipientId == request.auth.uid;
      allow create: if isApproved();
      allow update: if isAuth() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Join Codes ──
    match /joinCodes/{codeId} {
      // Authenticated users can read (to validate during registration)
      allow read: if isAuth();
      allow create: if isManager();
      // Allow update to mark as used (happens during registration flow)
      allow update: if isAuth();
      allow delete: if isAdmin();
    }
  }
}
